__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# --- ML-артефакты ---
# models/iris/ коммитим НАМЕРЕННО: файлы маленькие (~3 КБ), их копирует Dockerfile,
# а samples.json нужен тесту паритета. Крупные и промежуточные артефакты — не коммитим.
/models/*
!/models/iris/
*.ckpt
*.pt
*.pth
*.pkl
*.joblib
mlruns/

# --- Локальные данные сервисов (MinIO, PostgreSQL и т.п. в следующих проектах) ---
/data/
/.volumes/

# --- Секреты и локальные настройки окружения ---
.env
.env.*
!.env.example
*.pem
*.key

# --- IDE и редакторы ---
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~

